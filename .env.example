# ==============================================================================
# Brightloop Software — Subscription Management System Environment Configuration
# ==============================================================================

# System Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=brightloop-dev-insecure-secret-key-change-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,web,api

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=brightloop_db
DB_USER=brightloop_user
DB_PASSWORD=brightloop_secure_password_2026
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Brightloop Software"
PORT=3000

